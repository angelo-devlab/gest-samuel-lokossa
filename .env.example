# -----------------------------------------------------------------------------
# Pass-Samuel — variables d'environnement
#
# Copiez ce fichier en .env puis renseignez les valeurs du projet Supabase.
# Sans ces deux clés, l'application démarre en mode démonstration : les données
# restent dans le navigateur et rien n'est envoyé au serveur.
# -----------------------------------------------------------------------------

# URL du projet Supabase, ex. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Clé publique « anon ». Ne jamais déposer ici la clé service_role :
# elle contourne les politiques RLS et donnerait accès à tout le diocèse.
VITE_SUPABASE_ANON_KEY=

# Nom affiché sur les documents imprimés et les en-têtes PDF.
VITE_NOM_DIOCESE="Diocèse de Lokossa"
